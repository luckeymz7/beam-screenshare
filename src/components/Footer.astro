---
import Row from './Row.astro';
import { translator } from '../lib/i18n';

const t = translator(Astro.locals.lang);
---

<Row as="footer" class="footer">
  <p class="line">
    <span>
      {t('footer.relayed')} <a href="https://mounthost.com.br" class="link" target="_blank" rel="noopener">Mount Host</a>
    </span>
    <span class="sep">·</span>
    <span>
      {t('footer.madeBy')} <a href="https://lucasmaximiano.space" class="link" target="_blank" rel="noopener">Lucas M.</a>
    </span>
  </p>
</Row>

<style>
  :global(.footer) {
    margin-top: auto;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    padding-block: 2rem 2.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .line .link {
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .line {
      flex-direction: column;
    }
    .sep {
      display: none;
    }
  }
</style>
