---
import Layout from '../layouts/Layout.astro';
import Row from '../components/Row.astro';
import { translator } from '../lib/i18n';
import '../styles/room.css';

const t = translator(Astro.locals.lang);
Astro.response.status = 404;
---

<Layout title={`${t('page.nothing')} — beam`}>
  <Row line={false}>
    <div class="gate">
      <p class="eyebrow">404</p>
      <h1 class="gate-title">{t('page.nothing')}</h1>
      <p class="muted">{t('page.nothingBody')}</p>
      <div class="gate-actions"><a class="btn" href="/">{t('page.backHome')}</a></div>
    </div>
  </Row>
</Layout>
