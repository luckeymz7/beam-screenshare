---
import Layout from '../layouts/Layout.astro';
import Row from '../components/Row.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CreateRoom from '../components/CreateRoom';
import RoomList from '../components/RoomList';
import { listRooms, type RoomCard } from '../lib/rooms';
import { translator } from '../lib/i18n';
import { listFriends, type Friend } from '../lib/friends';

const { lang, user } = Astro.locals;
const t = translator(lang);
// Logged in: which friends are live right now
const friendsLive: Friend[] = user ? (await listFriends(user.id).catch(() => null))?.friends.filter((f) => f.live) ?? [] : [];
let rooms: RoomCard[] = [];
let failed = false;
try {
  rooms = await listRooms();
} catch (e) {
  failed = true;
  console.error('Could not list rooms:', (e as Error).message);
}

const features = [
  { icon: 'screen', title: t('home.f1.title'), body: t('home.f1.body') },
  { icon: 'volume', title: t('home.f2.title'), body: t('home.f2.body') },
  { icon: 'lock', title: t('home.f3.title'), body: t('home.f3.body') },
] as const;
---

<Layout>
  <Row line={false}>
    <div class="hero">
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1 class="headline" set:html={t('home.headline')} />
      <p class="lede">{t('home.lede')}</p>
      <ul class="features">
        {
          features.map((f) => (
            <li>
              <Icon name={f.icon} size={15} />
              <span>
                <strong>{f.title}</strong> {f.body}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </Row>

  {
    friendsLive.length > 0 && (
      <Section id="friends" eyebrow={t('friends.homeEyebrow')} title={t('friends.homeTitle')}>
        <ul class="friends-live">
          {friendsLive.map((f) => (
            <li>
              <span class="fl-avatar">
                {f.image ? (
                  <img src={f.image} alt="" width="32" height="32" referrerpolicy="no-referrer" />
                ) : (
                  <span>{f.name.slice(0, 1).toUpperCase()}</span>
                )}
                <span class="live-dot" />
              </span>
              <span class="fl-text">
                <strong>{f.name}</strong>
                <span>
                  {f.live?.title
                    ? t(f.live.hosting ? 'friends.hosting' : 'friends.inRoom', { title: f.live.title })
                    : t('friends.inPrivate')}
                </span>
              </span>
              {f.live?.room && (
                <a class="btn primary" href={`/r/${f.live.room}`}>
                  {t('friends.join')}
                </a>
              )}
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="start" eyebrow={t('home.startEyebrow')} title={t('home.startTitle')}>
    <CreateRoom client:load lang={lang} myName={user?.name} />
  </Section>

  <Section id="live" eyebrow={t('home.liveEyebrow')} title={t('home.liveTitle')}>
    <RoomList client:load lang={lang} initial={rooms} failed={failed} />
  </Section>
</Layout>

<style>
  .friends-live {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .friends-live li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
  }
  .fl-avatar {
    position: relative;
    flex: none;
    display: grid;
  }
  .fl-avatar img,
  .fl-avatar > span:first-child {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-serif);
    font-style: italic;
  }
  .fl-avatar :global(.live-dot) {
    position: absolute;
    right: -1px;
    bottom: -1px;
    border: 2px solid var(--bg);
    box-sizing: content-box;
  }
  .fl-text {
    display: grid;
    flex: 1;
    min-width: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .fl-text strong {
    color: var(--fg);
  }
  .fl-text span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .hero {
    padding-block: 4.5rem 3.5rem;
    max-width: 40rem;
  }
  .headline {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .headline em {
    color: var(--accent);
  }
  .lede {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 16px;
  }
  .features {
    display: grid;
    gap: 0.6rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 14px;
  }
  .features li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .features :global(svg) {
    flex: none;
    translate: 0 2px;
    color: var(--accent);
  }

  /* create form */
  :global(.create) {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
  }
  :global(.create-grid) {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
  }
  :global(.create-foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  :global(.create-foot .hint) {
    flex: 1;
    min-width: 12rem;
    color: var(--faint);
    font-size: 13px;
  }
  @media (max-width: 560px) {
    :global(.create-grid) {
      grid-template-columns: 1fr;
    }
  }

  /* room list */
  :global(.rooms) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.room) {
    display: grid;
    gap: 0.75rem;
    text-decoration: none;
  }
  :global(.preview) {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    transition: border-color 0.2s;
  }
  :global(.room:hover .preview) {
    border-color: var(--faint);
  }
  :global(.preview img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.4s ease;
  }
  :global(.room:hover .preview img) {
    scale: 1.03;
  }
  :global(.waiting) {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
  }
  :global(.badge) {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  :global(.meta) {
    display: grid;
    gap: 0.1rem;
  }
  :global(.meta .title) {
    color: var(--fg);
    font-weight: 600;
    font-size: 14px;
  }
  :global(.meta .sub) {
    display: flex;
    gap: 0.75rem;
    color: var(--faint);
    font-size: 11px;
  }
  :global(.viewers) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
  }
  :global(.empty) {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    padding: 3.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: center;
    color: var(--muted);
    font-family: var(--font-serif);
    font-style: italic;
  }
  :global(.empty .link) {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 13px;
  }
</style>
