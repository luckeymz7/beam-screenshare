# Copy to .env and fill in. Everything except LiveKit in production is optional:
# without a setting, its feature is simply off.

# LiveKit (the media server that relays the streams).
# Leave unset in development to use `bun run livekit` (LiveKit in --dev mode in Docker).
# In production: a project at https://cloud.livekit.io, or your own server.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Accounts, premium, previews and metrics. A local file by default; a Turso URL on Vercel.
DATABASE_URL=file:./data/beam.db
# DATABASE_AUTH_TOKEN=

# Login (optional for visitors). Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=   (required in production for any login, email included)
# BETTER_AUTH_URL=https://your-domain
# Google: console.cloud.google.com → Credentials → OAuth client (Web).
#   Redirect URI: https://your-domain/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Discord: discord.com/developers → New application → OAuth2.
#   Redirect: https://your-domain/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Who can open /admin (comma-separated emails of logged-in accounts)
# ADMIN_EMAILS=you@example.com

# Premium through AbacatePay (https://abacatepay.com). Create a product with cycle MONTHLY,
# then a webhook to https://your-domain/api/billing/webhook with a secret of your choice.
# A dev-mode API key is a sandbox where nothing is charged.
# ABACATEPAY_API_KEY=
# ABACATEPAY_PRODUCT_ID=
# ABACATEPAY_WEBHOOK_SECRET=
