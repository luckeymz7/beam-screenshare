# Copy to .env and fill in.

# LiveKit (the media server that relays the streams).
# Leave unset in development to use `bun run livekit` (LiveKit in --dev mode in Docker).
# In production: a project at https://cloud.livekit.io, or your own server.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Preview images of public rooms. A local file by default; a Turso URL on Vercel.
DATABASE_URL=file:./data/beam.db
# DATABASE_AUTH_TOKEN=
